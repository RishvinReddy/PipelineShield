# ==============================================================================
# PipelineShield Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real tokens into version control.
#
# On Vercel, configure these in Project Settings -> Environment Variables.
# ==============================================================================

# GitHub Personal Access Token (Fine-Grained or Classic)
# Permissions Required:
# - Repository: RishvinReddy/PipelineShield
# - Repository Permissions:
#     - Actions: Read-Only (to fetch workflow runs and download artifacts)
#     - Metadata: Read-Only (mandatory for fine-grained repository access)
# DO NOT grant administration, write, or secrets permissions.
GITHUB_TOKEN=github_pat_EXAMPLE_TOKEN_READ_ONLY_ACTIONS

# Target GitHub Repository (owner/repo)
GITHUB_REPOSITORY=RishvinReddy/PipelineShield
